---
import CtaBand from '@components/CtaBand.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { getPublicCorporateDocumentBySlug } from '@lib/documents/public';

export const prerender = false;

const { slug } = Astro.params;
const document = slug ? await getPublicCorporateDocumentBySlug(slug) : null;

if (!document) {
	return new Response('Not found', { status: 404 });
}

const dateFormatter = new Intl.DateTimeFormat('pt-BR', {
	dateStyle: 'long',
	timeZone: 'America/Sao_Paulo',
});

function formatDate(date: string | null) {
	return date ? dateFormatter.format(new Date(date)) : 'Não informado';
}
---

<BaseLayout title={document.title} description={document.summary ?? `Documento público da Gráfica Criasett: ${document.title}.`}>
	<section class="detail-hero detail-hero--article">
		<div class="detail-hero__text">
			<p class="eyebrow">{document.category.title}</p>
			<h1>{document.title}</h1>
			{document.summary && <p>{document.summary}</p>}
			<div class="button-row">
				<a class="button button--light" href={document.stablePdfUrl}>Abrir PDF</a>
				<a class="button button--ghost" href="/politicas">Voltar</a>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="section__inner detail-layout">
			<article class="rich-copy">
				<p>
					Esta página pública aponta sempre para a versão vigente do documento. Versões anteriores
					permanecem privadas até que a empresa decida expor histórico ou arquivo.
				</p>
			</article>
			<aside class="spec-panel">
				<p class="card-kicker">Documento</p>
				<div>
					<span>Categoria</span>
					<strong>{document.category.title}</strong>
				</div>
				<div>
					<span>Versão vigente</span>
					<strong>{document.currentVersion}</strong>
				</div>
				<div>
					<span>Vigência</span>
					<strong>{formatDate(document.effectiveDate)}</strong>
				</div>
				<div>
					<span>Revisao</span>
					<strong>{formatDate(document.revisionDate)}</strong>
				</div>
				{
					document.responsibleDepartment && (
						<div>
							<span>Responsável</span>
							<strong>{document.responsibleDepartment}</strong>
						</div>
					)
				}
			</aside>
		</div>
	</section>

	<CtaBand
		title="Precisa confirmar uma política?"
		text="Use o canal comercial da Criasett para confirmar documentos institucionais, certificações e arquivos de conformidade."
		href="/contato"
		label="Falar com a Criasett"
	/>
</BaseLayout>
