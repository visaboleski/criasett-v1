---
import CtaBand from '@components/CtaBand.astro';
import PortfolioGrid from '@components/PortfolioGrid.astro';
import SectionHeader from '@components/SectionHeader.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import {
	homeContent,
	portfolioItems,
	positioningCards,
	productionFlow,
	proofPoints,
	quoteChecklist,
	solutionGroups,
	structureAreas,
} from '@data/site';

const home = homeContent;
const featuredPortfolio = portfolioItems.slice(0, 3);
---

<BaseLayout
	title="Gráfica Criasett"
	description="Gráfica Criasett: embalagens, PDV e materiais promocionais produzidos em Santo André, SP."
>
	<section class="hero">
		<img class="hero__image" src="/images/industrial-print-hero.png" alt="Máquina gráfica industrial em operação" />
		<div class="hero__shade" aria-hidden="true"></div>
		<div class="hero__content">
			<p class="eyebrow">{home.eyebrow}</p>
			<h1>{home.headline}</h1>
			<p class="hero__intro">{home.intro}</p>
			<div class="button-row">
				<a class="button button--primary" href={home.primaryCtaHref}>{home.primaryCtaLabel}</a>
				<a class="button button--ghost" href={home.secondaryCtaHref}>{home.secondaryCtaLabel}</a>
			</div>
			<div class="hero__process" aria-label="Fluxo de produção">
				<span>Pré-impressão</span>
				<span>Impressão</span>
				<span>Acabamento</span>
				<span>Entrega</span>
			</div>
		</div>
	</section>

	<section class="credibility-band" aria-label="Diferenciais">
		{
			home.credibility.map((item) => (
				<div>
					<strong>{item.value}</strong>
					<span>{item.label}</span>
				</div>
			))
		}
	</section>

	<section class="section">
		<div class="section__inner">
			<SectionHeader
				eyebrow="Soluções"
				title="Impressos para embalagem, varejo e campanhas."
				text="A primeira leitura do site precisa ser comercial: o cliente entende rapidamente o que pode pedir, onde aquilo se aplica e como avançar para orçamento."
			/>
			<div class="solution-grid">
				{
					solutionGroups.map((solution) => (
						<article class={`solution-card accent-${solution.accent}`}>
							<div>
								<p class="card-kicker">Solução</p>
								<h3>{solution.title}</h3>
								<p>{solution.text}</p>
							</div>
							<ul class="tag-list">
								{solution.items.map((item) => <li>{item}</li>)}
							</ul>
							<a class="text-link card-link" href={solution.href}>Ver exemplo</a>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="section section--muted">
		<div class="section__inner split">
			<SectionHeader
				eyebrow="Posicionamento"
				title="Processo gráfico apresentado sem ruído."
				text="A presença digital precisa mostrar, em poucos segundos, que a Criasett não é uma gráfica genérica: é estrutura produtiva, método e confiança para empresas."
			/>
			<div class="proof-list">
				{
					positioningCards.map((card) => (
						<article>
							<span>{card.mark}</span>
							<h3>{card.title}</h3>
							<p>{card.text}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="section process-section" id="estrutura">
		<div class="section__inner process-layout">
			<div>
				<SectionHeader
					eyebrow="Estrutura"
					title="Da pré-impressão à expedição."
					text="Uma área para apresentar capacidade produtiva, equipamentos, controle de qualidade e etapas do processo de forma visual e objetiva."
				/>
				<div class="process-grid">
					{
						structureAreas.map((area, index) => (
							<article>
								<span>{String(index + 1).padStart(2, '0')}</span>
								<h3>{area.title}</h3>
								<p>{area.summary}</p>
							</article>
						))
					}
				</div>
				<a class="text-link section-link" href="/estrutura">Ver estrutura completa</a>
			</div>
			<div class="press-sheet" aria-label="Fluxo de produção">
				{productionFlow.map((step) => (
					<article>
						<span>{step.step}</span>
						<h3>{step.title}</h3>
						<p>{step.text}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="section__inner">
			<div class="section-row">
				<SectionHeader
					eyebrow="Portfólio"
					title="Categorias com leitura rápida."
					text="O portfólio começa organizado por Embalagem, PDV e Promocional, com espaço para fotos reais via ImageKit."
				/>
				<a class="text-link" href="/portfolio">Ver portfólio completo</a>
			</div>
			<PortfolioGrid items={featuredPortfolio} />
		</div>
	</section>

	<section class="section section--muted">
		<div class="section__inner split">
			<div>
				<SectionHeader
					eyebrow="Confiança"
					title="O site deve responder antes do primeiro contato."
					text="Para uma indústria gráfica B2B, bom design não é enfeite: é organizar decisão, risco, prazo, aplicação e acabamento."
				/>
				<div class="proof-columns">
					{
						proofPoints.map((point) => (
							<article>
								<h3>{point.title}</h3>
								<p>{point.text}</p>
							</article>
						))
					}
				</div>
			</div>
			<aside class="quote-checklist">
				<p class="eyebrow">Para orçamento</p>
				<h2>O que enviar para acelerar a resposta</h2>
				<ul>
					{quoteChecklist.map((item) => <li>{item}</li>)}
				</ul>
				<a class="button button--primary" href="/contato">Preparar orçamento</a>
			</aside>
		</div>
	</section>

	<CtaBand
		eyebrow="Políticas e compliance"
		title="PDFs e documentos públicos em uma biblioteca organizada."
		text="Em vez de arquivos soltos, as políticas ganham categorias, descrições e links claros para qualidade, sustentabilidade, privacidade e canal de denúncias."
		href="/politicas"
		label="Acessar políticas"
	/>
</BaseLayout>
