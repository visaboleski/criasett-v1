---
import CtaBand from '@components/CtaBand.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { portfolioItems, quoteChecklist } from '@data/site';

export function getStaticPaths() {
	return portfolioItems.map((item) => ({
		params: { slug: item.slug },
		props: { item },
	}));
}

const { item } = Astro.props;

const categoryLabel = {
	embalagem: 'Embalagem',
	pdv: 'PDV',
	promocional: 'Promocional',
}[item.category];
---

<BaseLayout title={item.title} description={item.summary}>
	<section class="detail-hero">
		<div class="detail-hero__text">
			<p class="eyebrow">{categoryLabel}</p>
			<h1>{item.title}</h1>
			<p>{item.summary}</p>
		</div>
		<div class={`portfolio-card__placeholder detail-hero__media tone-${item.category}`} aria-hidden="true">
			<span>{categoryLabel}</span>
		</div>
	</section>

	<section class="section">
		<div class="section__inner detail-layout">
			<article class="rich-copy">
				{item.description.map((paragraph) => <p>{paragraph}</p>)}
				<h2>Resultado esperado</h2>
				<p>{item.outcome}</p>
			</article>
			<aside class="spec-panel">
				<p class="card-kicker">Detalhes do projeto</p>
				{item.specs.map((spec) => (
					<div>
						<span>{spec.label}</span>
						<strong>{spec.value}</strong>
					</div>
				))}
				<ul class="tag-list">
					{item.materials.map((material) => <li>{material}</li>)}
				</ul>
			</aside>
		</div>
	</section>

	<section class="section section--muted">
		<div class="section__inner quote-layout">
			<div>
				<p class="eyebrow">Como cotar</p>
				<h2>Informações que ajudam neste tipo de projeto</h2>
				<p class="lead-copy">
					Para acelerar orçamento, envie referências visuais, medidas e arquivos quando já existirem. Se o projeto
					ainda estiver aberto, a equipe pode orientar o caminho técnico.
				</p>
			</div>
			<ul class="quote-list">
				{quoteChecklist.map((detail) => <li>{detail}</li>)}
			</ul>
		</div>
	</section>

	<CtaBand
		title="Tem um material parecido para produzir?"
		text="O fluxo de orçamento pode começar com fotos, medidas, tiragem estimada e referências de acabamento."
	/>
</BaseLayout>
