---
import CtaBand from '@components/CtaBand.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { blogPosts } from '@data/site';

export function getStaticPaths() {
	return blogPosts.map((post) => ({
		params: { slug: post.slug },
		props: { post },
	}));
}

const { post } = Astro.props;
---

<BaseLayout title={post.title} description={post.excerpt}>
	<section class="detail-hero detail-hero--article">
		<div class="detail-hero__text">
			<p class="eyebrow">{post.publishedAt}</p>
			<h1>{post.title}</h1>
			<p>{post.excerpt}</p>
			<ul class="tag-list tag-list--light">
				{post.tags.map((tag) => <li>{tag}</li>)}
			</ul>
		</div>
	</section>

	<section class="section">
		<div class="section__inner article-body">
			{
				post.body.map((section) => (
					<section>
						<h2>{section.heading}</h2>
						<p>{section.text}</p>
					</section>
				))
			}
		</div>
	</section>

	<CtaBand
		title="Conteúdo técnico deve ajudar o cliente a comprar melhor."
		text="Esta área permanece fora do escopo de lançamento e pode ser retomada futuramente se o conteúdo editorial fizer sentido."
		href="/blog"
		label="Voltar ao blog"
	/>
</BaseLayout>
