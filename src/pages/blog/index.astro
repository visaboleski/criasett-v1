---
import PageHero from '@components/PageHero.astro';
import SectionHeader from '@components/SectionHeader.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { blogPosts } from '@data/site';

const posts = blogPosts;
---

<BaseLayout title="Blog" description="Conteúdos técnicos e institucionais da Gráfica Criasett.">
	<PageHero
		eyebrow="Blog"
		title="Conhecimento gráfico para marcas e equipes."
		text="Guias, notícias e conteúdos úteis sobre impressão, embalagem, PDV, arquivos e acabamento."
	/>

	<section class="section">
		<div class="section__inner">
			<SectionHeader title="Publicações" text="Artigos locais por enquanto, com rota própria para cada post." />
			<div class="blog-list">
				{
					posts.map((post) => (
						<article>
							<p>{post.publishedAt}</p>
							<h2>{post.title}</h2>
							{post.excerpt && <span>{post.excerpt}</span>}
							<a class="text-link card-link" href={`/blog/${post.slug}`}>Ler artigo</a>
						</article>
					))
				}
			</div>
		</div>
	</section>
</BaseLayout>
