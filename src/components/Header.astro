---
const navItems = [
	{ href: '/', label: 'Home' },
	{ href: '/criasett', label: 'A Criasett' },
	{ href: '/estrutura', label: 'Estrutura' },
	{ href: '/certificacoes', label: 'Certificações' },
	{ href: '/politicas', label: 'Políticas' },
	{ href: '/contato', label: 'Contato' },
];

const productItems = [
	{ href: '/produtos/embalagens', label: 'Embalagens' },
	{ href: '/produtos/promocionais', label: 'Promocionais' },
];

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
const isExact = (href: string) => currentPath === href || currentPath === `${href}/`;
---

<header class="site-header">
	<a class="brand" href="/" aria-label="Criasett — página inicial">
		<img class="brand__logo" src="/images/Criasett_logo_Horizontal.png" alt="Criasett Indústria Gráfica" />
	</a>

	<nav class="desktop-nav" aria-label="Navegação principal">
		{navItems.slice(0, 3).map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
		<div class="desktop-products">
			<a href="/produtos" aria-current={isCurrent('/produtos') ? 'page' : undefined} aria-haspopup="true" aria-controls="desktop-product-categories">Produtos</a>
			<div class="desktop-products__menu" id="desktop-product-categories" aria-label="Categorias de produtos">
				{productItems.map((item) => <a href={item.href} aria-current={isExact(item.href) ? 'page' : undefined}>{item.label}</a>)}
			</div>
		</div>
		{navItems.slice(3).map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
	</nav>

	<details class="mobile-nav">
		<summary aria-label="Abrir navegação"><span></span><span></span><span></span></summary>
		<div class="mobile-nav__panel">
			{navItems.slice(0, 3).map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
			<div class="mobile-products">
				<a class="mobile-products__overview" href="/produtos" aria-current={isCurrent('/produtos') ? 'page' : undefined}>Produtos</a>
				<details class="mobile-products__toggle" open={isCurrent('/produtos')}>
					<summary aria-label="Expandir categorias de Produtos" aria-controls="mobile-product-categories">
						<svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4"></path></svg>
					</summary>
					<div class="mobile-products__submenu" id="mobile-product-categories">
						{productItems.map((item) => <a href={item.href} aria-current={isExact(item.href) ? 'page' : undefined}>{item.label}</a>)}
					</div>
				</details>
			</div>
			{navItems.slice(3).map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
		</div>
	</details>
</header>
