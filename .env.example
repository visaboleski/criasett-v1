# Public site URL used for sitemap/canonical URLs.
PUBLIC_SITE_URL=https://graficacriasett.com.br

# Set to staging only for temporary deployments that must remain noindex.
PUBLIC_DEPLOYMENT_ENVIRONMENT=

# Optional public media host override. The development R2 host is the source fallback.
PUBLIC_MEDIA_BASE_URL=

# ImageKit. We can add this after the account/media library exists.
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=

# Contact form provider settings will be added once we choose Resend, Brevo, etc.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
