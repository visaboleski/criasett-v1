# Public site URL used for sitemap/canonical URLs.
PUBLIC_SITE_URL=https://www.graficacriasett.com.br

# Supabase public runtime config. Use the project URL and publishable/anon key.
# Never commit real service-role keys, database passwords, or access tokens.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase key for Astro PDF delivery from the private corporate-documents bucket.
# Never prefix this with PUBLIC_ and never import it into browser/React code.
SUPABASE_SERVICE_ROLE_KEY=

# ImageKit. We can add this after the account/media library exists.
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=

# Contact form provider settings will be added once we choose Resend, Brevo, etc.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
