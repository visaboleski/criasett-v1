# Public site URL used for sitemap/canonical URLs.
PUBLIC_SITE_URL=https://www.graficacriasett.com.br

# Sanity CMS. Create these at https://sanity.io/manage when ready.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Optional: only needed later for draft preview / visual editing.
SANITY_API_READ_TOKEN=

# ImageKit. We can add this after the account/media library exists.
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=

# Contact form provider settings will be added once we choose Resend, Brevo, etc.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

